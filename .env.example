# ==========================================
# General & Environment Configuration
# ==========================================
ENVIRONMENT=development
DEBUG=True
RANDOM_SEED=42

# ==========================================
# Data Pre-processing & Dataset Splits
# ==========================================
DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
IMAGE_SIZE=224
TRAIN_SIZE=0.8
VAL_SIZE=0.1
TEST_SIZE=0.1

# ==========================================
# Model Training Configuration (PyTorch)
# ==========================================
MODEL_TYPE=SimpleCNN   # Options: SimpleCNN, ResNet18, LogisticRegression
BATCH_SIZE=32
EPOCHS=10
LEARNING_RATE=0.001

# ==========================================
# Experiment Tracking (MLflow)
# ==========================================
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=cats_vs_dogs_classification

# ==========================================
# Output Paths & Artifact Storage
# ==========================================
MODEL_OUTPUT_PATH=./models
LOG_DIR=./logs
OUTPUT_DIR=./outputs

# ==========================================
# Model Serving REST API (FastAPI)
# ==========================================
HOST=0.0.0.0
PORT=8000
MODEL_PATH=models/baseline_cnn.pt